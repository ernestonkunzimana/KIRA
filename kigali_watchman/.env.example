# KIRA - Production Environment Template
# SECURITY: This file contains placeholder values. Replace ALL with production secrets.
# 
# Before deploying:
#   1. Generate secure secrets: python3 -c "import secrets; print(secrets.token_hex(32))"
#   2. Update all placeholder values marked with 'replace-' or 'CHANGE_'
#   3. Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.) in production
#   4. Never commit actual secrets to version control
#   5. Run: FLASK_ENV=production python3 -c "from backend.main import create_app; create_app()"
#      to validate secrets before deployment

# ---- FLASK & JWT Security ----
# REQUIRED: Must be ≥32 bytes (256 bits) for HMAC-SHA256 (RFC 7518)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=production
SECRET_KEY=replace-with-secure-random-256-bit-hex-string-min-64-chars
JWT_SECRET_KEY=replace-with-secure-random-256-bit-hex-string-min-64-chars
JWT_EXPIRES_SECONDS=1800

# ---- API Client Authentication ----
# Format: "client_id:password,client_id2:password2"
# Each password should be ≥16 bytes random string.
# These credentials are used by external systems to obtain JWT tokens.
# Generate passwords: python3 -c "import secrets; print(secrets.token_hex(16))"
API_CLIENTS=sensor_gateway:replace-with-secure-random-32-char-password,dashboard:replace-with-secure-random-32-char-password,ops_team:replace-with-secure-random-32-char-password

# ---- AI Model Safety Thresholds ----
# Calibrated from training data. These trigger autonomous vs. human-confirmed actions.
AUTONOMOUS_THRESHOLD=0.88
ALERT_THRESHOLD=0.65
LOCKOUT_SECONDS=600

# ---- Request Rate Limiting ----
RATELIMIT_PREDICT=60 per minute

# ---- Redis (Cross-worker Global State) ----
# REQUIRED: Must point to a secure, networked Redis instance
# In production:
#   - Use a managed service (AWS ElastiCache, Azure Cache for Redis, etc.)
#   - Enable TLS/SSL (rediss:// scheme)
#   - Use strong authentication (requirepass or ACLs)
#   - Disable dangerous commands (FLUSHDB, FLUSHALL, CONFIG, etc.)
# Example: rediss://user:password@redis.example.com:6380/0
REDIS_URL=redis://redis:6379/0

# ---- Audit Database ----
AUDIT_DB_PATH=/app/audit/kira_audit.db

# ---- CORS (Frontend Access Control) ----
# In production, set to your frontend domain(s) only.
# NEVER use wildcard (*) in production.
# Example: https://dashboard.example.com,https://ops.example.com
ALLOWED_ORIGINS=https://dashboard.example.com

# ---- Optional: Twilio SMS Alerts ----
# If disabled (default), the system logs alerts but does not send SMS.
# To enable, set all four fields:
TWILIO_ENABLED=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_PHONE=

# ---- Frontend Dashboard ----
# Password for Streamlit dashboard login.
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
DASHBOARD_PASSWORD=replace-with-secure-random-32-char-password
