From b6ff6517bda1dc71bc575acd745e158d983ad206 Mon Sep 17 00:00:00 2001
From: ernest <ernest@example.com>
Date: Sat, 16 May 2026 01:06:51 -1000
Subject: [PATCH 1/2] backend: add privileged entrypoint to chown mounted
 volumes; ensure /app/logs and /app/audit are owned by UID 1001

---
 kigali_watchman/README.md             | 14 ++++
 kigali_watchman/backend/Dockerfile    | 22 +++++-
 kigali_watchman/backend/entrypoint.py | 99 +++++++++++++++++++++++++++
 3 files changed, 132 insertions(+), 3 deletions(-)
 create mode 100644 kigali_watchman/backend/entrypoint.py

diff --git a/kigali_watchman/README.md b/kigali_watchman/README.md
index fe02452..3243dee 100644
--- a/kigali_watchman/README.md
+++ b/kigali_watchman/README.md
@@ -40,6 +40,20 @@ Ensure you have Docker and Docker Compose installed.
    - **Core API**: `http://localhost:5000`
    - **API Documentation**: `http://localhost:5000/docs`
 
+   ### Host volume ownership (important)
+
+   When bind-mounting host directories for `/app/logs` or `/app/audit`, ensure the
+   host path is writable by the container runtime user (UID 1001). Two recommended
+   approaches:
+
+   - Change ownership on the host: `sudo chown -R 1001:1001 ./logs ./audit`
+   - Or make the directories world-writable (less secure): `chmod 0777 ./logs ./audit`
+
+   The backend image includes an entrypoint that will attempt to `chown` these
+   directories at container start when it runs as root (for example, during
+   orchestration deployments). If you prefer not to rely on that, pre-create and
+   chown the host directories before `docker-compose up`.
+
 ---
 
 ## 🛡️ Resilience & Safety Features
diff --git a/kigali_watchman/backend/Dockerfile b/kigali_watchman/backend/Dockerfile
index 7b7cb57..b8cd000 100644
--- a/kigali_watchman/backend/Dockerfile
+++ b/kigali_watchman/backend/Dockerfile
@@ -49,8 +49,17 @@ RUN useradd -m -u 1001 -s /usr/sbin/nologin -d /home/kira kira \
     && chown -R kira:kira /app \
     && chmod -R 755 /app
 
-# Switch to non-root user
-USER kira
+# Ensure runtime-writable directories exist and are owned by the non-root user.
+# Avoid declaring VOLUME for these paths in the Dockerfile because Docker will
+# initialize anonymous volumes at runtime with root ownership which causes
+# permission errors for a non-root runtime user. Manage mounts from compose
+# or runtime instead.
+RUN mkdir -p /app/logs /app/audit \
+    && chown -R 1001:1001 /app/logs /app/audit
+
+# Note: We intentionally keep the final image user as root so the entrypoint
+# can run privileged initialization (chown of bind mounts). The entrypoint
+# script will drop privileges to `kira` (UID 1001) before executing the app.
 
 # Set Python environment variables
 ENV PATH="/home/kira/.local/bin:$PATH"
@@ -59,7 +68,6 @@ ENV PYTHONDONTWRITEBYTECODE=1
 
 # Security: mark filesystem as read-only (enforced by docker-compose or k8s)
 # Applications using temporary storage should mount volumes explicitly
-VOLUME [ "/app/logs", "/app/audit" ]
 
 # Health check (SRE / orchestration probes)
 HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
@@ -68,6 +76,14 @@ HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
 # Expose port (documentation only; port binding happens at runtime)
 EXPOSE 5000
 
+# Copy and install the privileged entrypoint that will fix ownership of
+# mounted host directories then drop to the non-root runtime user.
+COPY entrypoint.py /usr/local/bin/entrypoint.py
+RUN chmod +x /usr/local/bin/entrypoint.py
+
+# Entrypoint runs as PID 1 (initialization + privilege drop)
+ENTRYPOINT ["python3", "/usr/local/bin/entrypoint.py"]
+
 # Production entrypoint: gunicorn with 4 workers
 # Workers auto-scale based on CPU cores if run with --worker-class gthread
 CMD ["gunicorn", \
diff --git a/kigali_watchman/backend/entrypoint.py b/kigali_watchman/backend/entrypoint.py
new file mode 100644
index 0000000..287c76e
--- /dev/null
+++ b/kigali_watchman/backend/entrypoint.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""
+Entrypoint for the KIRA backend container.
+
+Responsibilities:
+- Ensure runtime-mounted directories are writable by the runtime user (UID 1001).
+- If directories are present (bind-mounted), recursively chown them to UID/GID 1001.
+- Drop privileges to UID/GID 1001 and exec the final command.
+
+This avoids requiring the container to be started as root in production while still
+allowing safe ownership fixes for bind-mounted host directories.
+"""
+import os
+import sys
+import stat
+
+
+TARGET_UID = 1001
+TARGET_GID = 1001
+TARGET_DIRS = ["/app/logs", "/app/audit"]
+
+
+def safe_chown(path, uid, gid):
+    try:
+        for root, dirs, files in os.walk(path):
+            try:
+                os.chown(root, uid, gid)
+            except Exception:
+                pass
+            for d in dirs:
+                try:
+                    os.chown(os.path.join(root, d), uid, gid)
+                except Exception:
+                    pass
+            for f in files:
+                try:
+                    os.chown(os.path.join(root, f), uid, gid)
+                except Exception:
+                    pass
+    except Exception:
+        # Best-effort: ignore failures (mounted dirs may be read-only)
+        return
+
+
+def main():
+    # If we're running as root, attempt to chown target directories when they exist
+    euid = os.geteuid()
+    if euid == 0:
+        for d in TARGET_DIRS:
+            if os.path.exists(d):
+                try:
+                    # ensure directory exists
+                    os.makedirs(d, exist_ok=True)
+                except Exception:
+                    pass
+                try:
+                    os.chown(d, TARGET_UID, TARGET_GID)
+                except Exception:
+                    pass
+                safe_chown(d, TARGET_UID, TARGET_GID)
+
+    # Prepare command to exec
+    cmd = sys.argv[1:]
+    if not cmd:
+        # Default to gunicorn command used historically
+        cmd = [
+            "gunicorn",
+            "--bind",
+            "0.0.0.0:5000",
+            "--workers",
+            "4",
+            "--worker-class",
+            "sync",
+            "--timeout",
+            "120",
+            "--log-level",
+            "info",
+            "--access-logfile",
+            "-",
+            "--error-logfile",
+            "-",
+            "main:create_app()",
+        ]
+
+    # Drop privileges if running as root
+    try:
+        if os.geteuid() == 0:
+            os.setgid(TARGET_GID)
+            os.setuid(TARGET_UID)
+    except Exception:
+        # If dropping privileges fails, continue — the process will run as-is
+        pass
+
+    # Exec the final command (replacing PID 1)
+    os.execvp(cmd[0], cmd)
+
+
+if __name__ == "__main__":
+    main()
