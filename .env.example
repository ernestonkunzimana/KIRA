# KIRA: Enterprise Configuration Template
# Copy this to .env and fill in your values for production deployment

# ============================================================================
# MQTT Broker Configuration
# ============================================================================
MQTT_BROKER=mqtt-broker
MQTT_PORT=8883
MQTT_PROTOCOL=MQTTv311
MQTT_KEEPALIVE=60

# ============================================================================
# TLS/mTLS Security
# ============================================================================
# Path to CA certificate (relative to container /app/certs/)
MQTT_CA_CERT=/app/certs/ca.crt
MQTT_CLIENT_CERT=/app/certs/client.crt
MQTT_CLIENT_KEY=/app/certs/client.key

# TLS verification (PRODUCTION: set to False only for local testing)
MQTT_TLS_INSECURE=false
MQTT_TLS_VERSION=TLSv1_3

# ============================================================================
# AI Model Configuration
# ============================================================================
# Baseline training threshold (minimum packets before model is ready)
TRAINING_THRESHOLD=30

# Expected anomaly rate in baseline data (Isolation Forest contamination)
CONTAMINATION_RATE=0.01

# Model persistence location
MODEL_CACHE=/app/src/edge_model.pkl

# ============================================================================
# Logging & Audit
# ============================================================================
# Enable structured JSON logging (SIEM-ready)
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# Log directory
LOG_DIR=/app/logs

# Enable log encryption at rest (requires ENCRYPTION_KEY)
ENABLE_LOG_ENCRYPTION=true

# Base64-encoded Fernet key for log encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# ============================================================================
# SIEM Integration (Webhook Dispatch)
# ============================================================================
# Splunk HTTP Event Collector
SPLUNK_HEC_ENABLED=false
SPLUNK_HEC_URL=https://your-splunk-instance:8088/services/collector
SPLUNK_HEC_TOKEN=your-hec-token

# PagerDuty Integration
PAGERDUTY_ENABLED=false
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key
PAGERDUTY_ROUTING_KEY=your-routing-key

# Slack Webhooks
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#security-alerts
SLACK_MENTIONS=@security-team

# ============================================================================
# Remediation Engine
# ============================================================================
# Enable automated remediation (container isolation, network quarantine)
REMEDIATION_ENABLED=true

# Remediation timeout (seconds)
REMEDIATION_TIMEOUT=30

# Remediation decision matrix (JSON-encoded)
# Severity thresholds for auto-triggering remediation
REMEDIATION_THRESHOLDS={
  "critical": 0.95,
  "warning": 0.75
}

# ============================================================================
# Secrets Management
# ============================================================================
# HashiCorp Vault (enterprise deployments)
VAULT_ENABLED=false
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=your-vault-token
VAULT_PATH=secret/kira/credentials

# AWS Secrets Manager
AWS_SECRETS_ENABLED=false
AWS_REGION=us-east-1
AWS_SECRETS_NAME=kira/prod/credentials

# ============================================================================
# Database & Persistence (Optional)
# ============================================================================
# Redis for model caching
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL for audit logs
POSTGRES_ENABLED=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kira_platform
POSTGRES_USER=kira_user
POSTGRES_PASSWORD=change-me

# Backend API / Frontend Dashboard
BACKEND_API_URL=http://backend-api:8000
CORS_ORIGINS=*
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ============================================================================
# Kubernetes/Cloud Deployment (Optional)
# ============================================================================
KUBERNETES_ENABLED=false
DOCKER_REGISTRY=your-registry.azurecr.io
DOCKER_IMAGE=kira-agent:1.0.0

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Prometheus metrics endpoint
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317

# ============================================================================
# Enterprise Features
# ============================================================================
# Role-based access control (RBAC)
RBAC_ENABLED=true
DEFAULT_USER_ROLE=OPERATOR

# Compliance & Audit
COMPLIANCE_MODE=ISO27001  # Options: NIST, ISO27001, PCI-DSS, SOC2
AUDIT_RETENTION_DAYS=2555  # ~7 years for compliance

# Model versioning
MODEL_VERSIONING_ENABLED=true
MODEL_VERSION=1.0.0

# ============================================================================
# Development & Testing
# ============================================================================
# Debug mode (PRODUCTION: set to false)
DEBUG=false

# Verbose logging
VERBOSE=false

# Skip TLS verification (DEVELOPMENT ONLY)
DEVELOPMENT_MODE=false
