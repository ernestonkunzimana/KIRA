# KIRA Production Environment Variables
# Copy to .env and fill in actual values (DO NOT commit .env to Git)

# ============================================================================
# FLASK & SECURITY
# ============================================================================
SECRET_KEY="your-super-secret-flask-key-change-this-in-production-12345678"
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production-87654321"
FLASK_ENV="production"
DEBUG="false"

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (development only)
DATABASE_URL="sqlite:///kira_audit.db"

# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://user:password@postgres.example.com:5432/kira_prod"
# DB_HOST="postgres.example.com"
# DB_PORT="5432"
# DB_NAME="kira_prod"
# DB_USER="kira"
# DB_PASSWORD="secure-db-password-here"

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL="redis://redis:6379/0"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""  # Set if Redis requires auth

# ============================================================================
# API SETTINGS
# ============================================================================
API_HOST="0.0.0.0"
API_PORT="5000"
API_WORKERS="4"
API_TIMEOUT="120"
API_THREADS="4"

# ============================================================================
# FRONTEND
# ============================================================================
STREAMLIT_SERVER_PORT="8501"
STREAMLIT_SERVER_HEADLESS="true"
STREAMLIT_CLIENT_TOOLBARPOSITION="top"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Default dashboard credentials (change these!)
DASHBOARD_CLIENT_ID="dashboard"
DASHBOARD_CLIENT_SECRET="kira-dashboard-2024"  # Change in production!
DASHBOARD_TOKEN_EXPIRY="86400"  # 24 hours in seconds

# ============================================================================
# RATE LIMITING
# ============================================================================
RATELIMIT_STORAGE_URL="redis://redis:6379/1"
RATELIMIT_DEFAULT="100/hour"
RATELIMIT_STRICT_RATELIMIT_EXCEEDED_STATUS_CODE="429"

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL="INFO"
LOG_FORMAT="json"  # or "text"
ENABLE_HEALTH_CHECKS="true"
ENABLE_METRICS="true"

# ============================================================================
# NGINX & TLS
# ============================================================================
NGINX_SERVER_NAME="kira.example.com"
NGINX_SSL_ENABLED="true"
NGINX_SSL_CERT="/etc/nginx/certs/server.crt"
NGINX_SSL_KEY="/etc/nginx/certs/server.key"
NGINX_UPSTREAM_API="http://backend:5000"
NGINX_UPSTREAM_FRONTEND="http://dashboard:8501"

# ============================================================================
# MODEL SETTINGS
# ============================================================================
MODEL_PATH="/app/models"
USE_FALLBACK_INFERENCE="false"  # Set true if ML models unavailable
ENABLE_MODEL_SERVING="true"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AUDIT_LOGGING="true"
ENABLE_AUDIT_TRAIL="true"
ENABLE_SHAP_EXPLANATIONS="true"
ENABLE_MANUAL_OVERRIDE="true"
ENABLE_ASYNC_PREDICTIONS="false"

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
BACKUP_STORAGE="s3://kira-backups"  # or "local://" for local backups

# ============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================================================
# AWS
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SECRETS_MANAGER_ENABLED="false"

# DataDog / Monitoring
DATADOG_ENABLED="false"
DATADOG_API_KEY=""
DATADOG_APP_KEY=""

# Sentry / Error Tracking
SENTRY_ENABLED="false"
SENTRY_DSN=""

# Slack / Notifications
SLACK_ENABLED="false"
SLACK_WEBHOOK_URL=""

# ============================================================================
# CORS & SECURITY HEADERS
# ============================================================================
ALLOWED_ORIGINS="https://kira.example.com,https://www.kira.example.com"
CORS_ALLOW_CREDENTIALS="true"
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,OPTIONS"

# ============================================================================
# CONTAINER SETTINGS
# ============================================================================
CONTAINER_REGISTRY="docker.io"
CONTAINER_IMAGE_TAG="latest"
CONTAINER_MEMORY_LIMIT="2g"
CONTAINER_CPU_LIMIT="1000m"
